"
I generate build.cmake, the one-command build for an exported plugin project.

I am a CMake script, not a shell script, so the same file runs on macOS, Linux and Windows: CMake is already required to build the plugin, so it is the one tool every user has. The script configures once, builds Release incrementally on all cores, and fails loudly. JUCE installs the plugins itself (COPY_PLUGIN_AFTER_BUILD).

I need only the product name, so I know nothing about the DSP. DSP >> createBuildScriptNamed: writes me next to CMakeLists.txt during every export.

In the exported folder, on any platform:
_language=C
	cmake -P build.cmake
	cmake -DJUCE_PATH=/path/to/JUCE -P build.cmake_
Usage from Pharo:
```langueage=Pharo
	(PhBuildScript for: (PhPluginIdentity productName: 'MyPhaustoPlugin')) contents
	```
"
Class {
	#name : 'PhBuildScript',
	#superclass : 'Object',
	#instVars : [
		'productName'
	],
	#category : 'Phausto-Exporting',
	#package : 'Phausto',
	#tag : 'Exporting'
}

{ #category : 'instance creation' }
PhBuildScript class >> for: aPhPluginIdentity [

	^ self new initializeProductName: aPhPluginIdentity productName
]

{ #category : 'accessing' }
PhBuildScript >> contents [
	"CMake script mode: the same file runs on macOS, Linux and Windows."

	^ '# Generated by Phausto. Builds <NAME> and installs the plugins.
# Usage on macOS, Linux and Windows:  cmake -P build.cmake
# With a local JUCE checkout:         cmake -DJUCE_PATH=/path/to/JUCE -P build.cmake
# To switch JUCE source, delete the build folder first.
cmake_minimum_required(VERSION 3.22)

set(project_dir "${CMAKE_CURRENT_LIST_DIR}")
set(build_dir "${project_dir}/build")

if(NOT EXISTS "${build_dir}/CMakeCache.txt")
    set(configure_args -S "${project_dir}" -B "${build_dir}" -DCMAKE_BUILD_TYPE=Release)
    if(DEFINED JUCE_PATH)
        list(APPEND configure_args "-DJUCE_PATH=${JUCE_PATH}")
    elseif(DEFINED ENV{JUCE_PATH})
        list(APPEND configure_args "-DJUCE_PATH=$ENV{JUCE_PATH}")
    else()
        message(STATUS "No JUCE_PATH: downloading JUCE. The first build takes a few minutes.")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" ${configure_args} RESULT_VARIABLE failed)
    if(failed)
        message(FATAL_ERROR "Configuring <NAME> failed.")
    endif()
endif()

cmake_host_system_information(RESULT cores QUERY NUMBER_OF_LOGICAL_CORES)
execute_process(
    COMMAND "${CMAKE_COMMAND}" --build "${build_dir}" --config Release --parallel ${cores}
    RESULT_VARIABLE failed)
if(failed)
    message(FATAL_ERROR "Building <NAME> failed.")
endif()

message(STATUS "Built <NAME>. JUCE copied the plugins into your system plug-in folders.")
message(STATUS "Standalone app: ${build_dir}/<NAME>_artefacts/Release/Standalone/")
' copyReplaceAll: '<NAME>' with: productName
]

{ #category : 'accessing' }
PhBuildScript >> fileName [
^ 'build.cmake'
]

{ #category : 'initialization' }
PhBuildScript >> initializeProductName: aString [

	productName := aString
]
