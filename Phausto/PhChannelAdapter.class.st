"
I write PhaustoChannelAdapter.h, the C++ Adapter between the plugin buses and the channels the Faust program declares.

Faust never runs in place: the adapter copies the input bus into a Faust input buffer, lets compute fill a Faust output buffer, then maps that onto the output bus. One rule both ways: going down to one channel averages, going up repeats the last channel, so a mono program feeds both sides.

The processor sizes me in prepareToPlay with both the program channel counts and the bus layout, so all memory is allocated there and process is real-time safe. The C++ is the same for every export, so I hold no state.
"
Class {
	#name : 'PhChannelAdapter',
	#superclass : 'Object',
	#category : 'Phausto-Exporting',
	#package : 'Phausto',
	#tag : 'Exporting'
}

{ #category : 'accessing' }
PhChannelAdapter >> contents [
	"The same C++ for every export. The processor sizes it in prepareToPlay."

	^ '#pragma once

#include <JuceHeader.h>
#include <vector>

/*  Generated by Phausto, rewritten on every export.

    Adapter between the plugin buses and the channels the Faust program declares.
    Faust never runs in place: process copies the input bus into the Faust input
    buffer, lets compute fill the Faust output buffer, then maps that onto the
    output bus. One rule both ways: down to one channel averages, up repeats the
    last channel, so a mono program feeds both sides.
    prepare allocates everything, so process is real-time safe.
*/
class PhaustoChannelAdapter
{
public:
    void prepare (int numFaustInputs, int numFaustOutputs,
                  int numBusInputs, int numBusOutputs, int maximumBlockSize)
    {
        blockSize = juce::jmax (1, maximumBlockSize);
        faustIn.setSize (numFaustInputs, blockSize);
        faustOut.setSize (numFaustOutputs, blockSize);
        busIn.resize ((size_t) numBusInputs);
        busOut.resize ((size_t) numBusOutputs);
    }

    template <typename DspType>
    void process (DspType& faust, juce::AudioBuffer<float>& bus)
    {
        if (blockSize == 0)
        {
            bus.clear();
            return;
        }

        const int numIn = juce::jmin ((int) busIn.size(), bus.getNumChannels());
        const int numOut = juce::jmin ((int) busOut.size(), bus.getNumChannels());

        // Hosts may send more samples than prepareToPlay announced, so run in chunks.
        for (int start = 0; start < bus.getNumSamples(); start += blockSize)
        {
            const int count = juce::jmin (blockSize, bus.getNumSamples() - start);

            for (int c = 0; c < numIn; ++c)
                busIn[(size_t) c] = bus.getReadPointer (c, start);

            remap (busIn.data(), numIn,
                   faustIn.getArrayOfWritePointers(), faustIn.getNumChannels(), count);

            faust.compute (count,
                           const_cast<float**> (faustIn.getArrayOfWritePointers()),
                           const_cast<float**> (faustOut.getArrayOfWritePointers()));

            for (int c = 0; c < numOut; ++c)
                busOut[(size_t) c] = bus.getWritePointer (c, start);

            remap (faustOut.getArrayOfReadPointers(), faustOut.getNumChannels(),
                   busOut.data(), numOut, count);
        }
    }

private:
    // Down to one channel: the average. Otherwise channel k takes source k and the
    // last source repeats, so mono feeds every channel. No source: silence.
    static void remap (const float* const* source, int numSources,
                       float* const* dest, int numDests, int count)
    {
        if (numSources == 0)
        {
            for (int d = 0; d < numDests; ++d)
                juce::FloatVectorOperations::clear (dest[d], count);
            return;
        }

        if (numDests == 1 && numSources > 1)
        {
            const float gain = 1.0f / (float) numSources;
            juce::FloatVectorOperations::copyWithMultiply (dest[0], source[0], gain, count);

            for (int s = 1; s < numSources; ++s)
                juce::FloatVectorOperations::addWithMultiply (dest[0], source[s], gain, count);

            return;
        }

        for (int d = 0; d < numDests; ++d)
            juce::FloatVectorOperations::copy (dest[d], source[juce::jmin (d, numSources - 1)], count);
    }

    juce::AudioBuffer<float> faustIn, faustOut;
    std::vector<const float*> busIn;
    std::vector<float*> busOut;
    int blockSize = 0;
};
'
]

{ #category : 'accessing' }
PhChannelAdapter >> fileName [

	^ 'PhaustoChannelAdapter.h'
]
