"
German church bell modal model generated by `mesh2faust` from `libraries/modalmodels/germanBell`.
Modeled after D.Bartocha and Baron, Influence of Tin Bronze Melting and Pouring Parameters on Its Properties and Bell' Tone, Archives of Foundry Engineering, 2016.
Model height is 1 m.
This model contains 7 excitation positions going linearly from the bottom to the top of the bell. Obviously, a model with more excitation position could be regenerated using `mesh2faust`.

Faust: `pm.germanBellModel(nModes, exPos, t60, t60DecayRatio, t60DecaySlope)` (1 in / 1 out)

## Parameters

- **nModes**: number of synthesized modes (max: 50) _(compile-time constant: give me a Number)_
- **exPos**: excitation position (0-6)
- **t60**: T60 in seconds (recommended value: 0.1)
- **t60DecayRatio**: T60 decay ratio (recommended value: 1)
- **t60DecaySlope**: T60 decay slope (recommended value: 5)

## Example

```language=Pharo
(PhGermanBellModel new input: PhImpulseExcitation new) stereo asDsp
```
"
Class {
	#name : 'PhGermanBellModel',
	#superclass : 'ModalPercussion',
	#instVars : [
		'nModes',
		'exPos',
		't60',
		't60DecayRatio',
		't60DecaySlope'
	],
	#category : 'Phausto-PhysModels - Modal Percussions',
	#package : 'Phausto',
	#tag : 'PhysModels - Modal Percussions'
}

{ #category : 'faust' }
PhGermanBellModel class >> argumentDescriptions [

	^ Dictionary newFrom: {
			#nModes -> 'number of synthesized modes (max: 50)'.
			#exPos -> 'excitation position (0-6)'.
			#t60 -> 'T60 in seconds (recommended value: 0.1)'.
			#t60DecayRatio -> 'T60 decay ratio (recommended value: 1)'.
			#t60DecaySlope -> 'T60 decay slope (recommended value: 5)' }
]

{ #category : 'faust' }
PhGermanBellModel class >> argumentNames [

	^ #( #nModes #exPos #t60 #t60DecayRatio #t60DecaySlope )
]

{ #category : 'faust' }
PhGermanBellModel class >> faustName [

	^ 'germanBellModel'
]

{ #category : 'accessing' }
PhGermanBellModel >> exPos [

	^ exPos
]

{ #category : 'accessing' }
PhGermanBellModel >> exPos: aNumberOrABoxOrASymbol [

	<paramSetter>
	self paramSetter value: aNumberOrABoxOrASymbol
]

{ #category : 'accessing' }
PhGermanBellModel >> excitation [

	"the excitation is the input signal of this function"

	^ input
]

{ #category : 'accessing' }
PhGermanBellModel >> excitation: aUnitGenerator [

	self input: aUnitGenerator
]

{ #category : 'initialization' }
PhGermanBellModel >> initializeArguments [

	nModes := 50.
	exPos := PhHSlider new
			label: self label , 'ExPos'
			values: #( 0 0 6 1 ).
	t60 := PhHSlider new
			label: self label , 'T60'
			values: #( 0.1 0.01 30 0.01 ).
	t60DecayRatio := PhHSlider new
			label: self label , 'T60DecayRatio'
			values: #( 1 0 5 0.01 ).
	t60DecaySlope := PhHSlider new
			label: self label , 'T60DecaySlope'
			values: #( 5 0 10 0.01 )
]

{ #category : 'accessing' }
PhGermanBellModel >> nModes [

	^ nModes
]

{ #category : 'accessing' }
PhGermanBellModel >> nModes: aNumberOrABoxOrASymbol [

	<paramSetter>
	self paramSetter value: aNumberOrABoxOrASymbol
]

{ #category : 'accessing' }
PhGermanBellModel >> t60 [

	^ t60
]

{ #category : 'accessing' }
PhGermanBellModel >> t60: aNumberOrABoxOrASymbol [

	<paramSetter>
	self paramSetter value: aNumberOrABoxOrASymbol
]

{ #category : 'accessing' }
PhGermanBellModel >> t60DecayRatio [

	^ t60DecayRatio
]

{ #category : 'accessing' }
PhGermanBellModel >> t60DecayRatio: aNumberOrABoxOrASymbol [

	<paramSetter>
	self paramSetter value: aNumberOrABoxOrASymbol
]

{ #category : 'accessing' }
PhGermanBellModel >> t60DecaySlope [

	^ t60DecaySlope
]

{ #category : 'accessing' }
PhGermanBellModel >> t60DecaySlope: aNumberOrABoxOrASymbol [

	<paramSetter>
	self paramSetter value: aNumberOrABoxOrASymbol
]
